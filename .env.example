# Variables de Entorno - CoffeeOS (Benevento)
PORT=3000
NODE_ENV=development

# Base de Datos Local (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/benevento_coffee_os?schema=public"

# Hardware de Impresión (Xprinter XP-80T)
PRINTER_TYPE=mock # 'mock' para pruebas de desarrollo, 'tcp' para impresora de red LAN
PRINTER_HOST=192.168.1.200 # IP de la Xprinter XP-80T en red local
PRINTER_PORT=9100

# Tienda y Caja por Defecto
DEFAULT_STORE_ID=store-benevento-01
DEFAULT_REGISTER_CODE=C1
