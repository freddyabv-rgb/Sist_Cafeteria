datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// NÚCLEO DE PLATAFORMA & AUDITORÍA
// ==========================================

model Store {
  id          String   @id @default(uuid())
  name        String
  taxId       String   // RUC / Identificador fiscal
  timezone    String   @default("America/Lima")
  currency    String   @default("PEN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registers   Register[]
  users       User[]
  categories  Category[]
  products    Product[]
  orders      Order[]
  shifts      RegisterShift[]
  auditLogs   AuditLog[]

  @@map("core_stores")
}

model Register {
  id          String   @id @default(uuid())
  storeId     String
  name        String   // ej. "Caja Mostrador 1"
  code        String   // ej. "C1"
  isActive    Boolean  @default(true)

  store       Store    @relation(fields: [storeId], references: [id])
  orders      Order[]
  shifts      RegisterShift[]

  @@map("core_registers")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  CASHIER
  BARISTA
}

model User {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  role        UserRole
  pinHash     String    // Hash con salt para login rápido en POS con PIN
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  openedShifts RegisterShift[] @relation("ShiftOpenedBy")
  closedShifts RegisterShift[] @relation("ShiftClosedBy")
  auditLogs   AuditLog[]

  @@map("core_users")
}

model AuditLog {
  id          String   @id @default(uuid())
  storeId     String
  userId      String
  action      String   // VOID_ORDER, DISCOUNT_APPLIED, CASH_DROP, SHIFT_CLOSE_DIFF
  entity      String   // ORDER, SHIFT, PRODUCT
  entityId    String
  beforeState Json?
  afterState  Json?
  deviceInfo  String?
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("core_audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventId       String    @unique
  eventType     String    // ej. "order.paid.v1"
  schemaVersion Int       @default(1)
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, attempts])
  @@map("core_outbox_events")
}

model ProcessedEvent {
  eventId     String
  handler     String
  processedAt DateTime @default(now())

  @@id([eventId, handler])
  @@map("core_processed_events")
}

// ==========================================
// CATÁLOGO & MODIFICADORES DE CAFETERÍA
// ==========================================

model Category {
  id           String    @id @default(uuid())
  storeId      String
  name         String    // ej. "Cafetería Caliente", "Helados", "Pastelería"
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)

  store        Store     @relation(fields: [storeId], references: [id])
  products     Product[]

  @@map("catalog_categories")
}

enum ProductSource {
  OWN          // Elaboración propia en obrador
  THIRD_PARTY  // Adquirido terminado de proveedor externo
}

enum TrackingMode {
  BY_UNIT      // Descuento unitario (vitrina, bebidas embotelladas)
  BY_RECIPE    // Descuento por receta de taza (Fase B)
  NONE         // Sin control estricto de inventario
}

model Product {
  id           String        @id @default(uuid())
  storeId      String
  categoryId   String
  name         String        // ej. "Latte", "Croissant de Almendras", "Gelato Doble"
  shortName    String?
  source       ProductSource @default(OWN)
  trackingMode TrackingMode  @default(BY_UNIT)
  taxCode      String        @default("IGV_GRAVADO")
  isAvailable  Boolean       @default(true)
  allergenTags String[]      @default([])
  isActive     Boolean       @default(true)

  store        Store         @relation(fields: [storeId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  modifierGroups ProductModifierGroup[]

  @@map("catalog_products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String   // ej. "8oz", "12oz", "16oz", "Unidad", "2 Bolas"
  price     Decimal  @db.Decimal(12, 2)
  sku       String?

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("catalog_product_variants")
}

model ModifierGroup {
  id            String   @id @default(uuid())
  storeId       String
  name          String   // ej. "Tipo de Leche", "Extras de Café", "Toppings de Helado"
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  isRequired    Boolean  @default(false)

  products      ProductModifierGroup[]
  options       ModifierOption[]

  @@map("catalog_modifier_groups")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  displayOrder    Int    @default(0)

  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("catalog_product_modifier_groups")
}

model ModifierOption {
  id              String        @id @default(uuid())
  modifierGroupId String
  name            String        // ej. "Leche de Avena", "Extra Shot", "Fudge Artesanal"
  priceDelta      Decimal       @default(0.00) @db.Decimal(12, 2)
  maxQuantity     Int           @default(1)
  highlightKds    Boolean       @default(false)
  allergenTags    String[]      @default([])

  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@map("catalog_modifier_options")
}

// ==========================================
// VENTAS & COMPROBANTES DE CAJA
// ==========================================

enum OrderChannel {
  POS
  QR
  PICKUP
}

enum OrderType {
  TAKEAWAY
  DINE_IN
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PrepStation {
  BARRA
  COCINA
  VITRINA
}

model Order {
  id                 String        @id @default(uuid())
  storeId            String
  registerId         String
  shiftId            String
  orderNumber        String        // ej. "C1-0104"
  idempotencyKey     String        @unique
  channel            OrderChannel  @default(POS)
  orderType          OrderType     @default(TAKEAWAY)
  paymentStatus      PaymentStatus @default(UNPAID)
  status             OrderStatus   @default(RECEIVED)
  
  customerName       String?
  customerDocType    String?       // "DNI", "RUC"
  customerDocNumber  String?

  subtotal           Decimal       @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal       @db.Decimal(12, 2)
  tipTotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  roundingAdjustment Decimal       @default(0.00) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)

  voidReason         String?
  voidedByUserId     String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())

  store              Store         @relation(fields: [storeId], references: [id])
  register           Register      @relation(fields: [registerId], references: [id])
  shift              RegisterShift @relation(fields: [shiftId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]

  @@map("sales_orders")
}

enum ItemPrepStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  VOIDED
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  productVariantId String
  productName      String         // Snapshot inmutable
  variantName      String         // Snapshot inmutable
  station          PrepStation    @default(BARRA)
  status           ItemPrepStatus @default(PENDING)
  quantity         Int            @default(1)
  unitPrice        Decimal        @db.Decimal(12, 2)
  discountAmount   Decimal        @default(0.00) @db.Decimal(12, 2)
  taxCode          String         @default("IGV_GRAVADO")
  taxAmount        Decimal        @db.Decimal(12, 2)
  totalPrice       Decimal        @db.Decimal(12, 2)
  notes            String?
  voidReason       String?

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  modifiers        OrderItemModifier[]

  @@map("sales_order_items")
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  groupName        String         // Snapshot inmutable
  optionName       String         // Snapshot inmutable
  quantity         Int            @default(1)
  priceDelta       Decimal        @db.Decimal(12, 2)

  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option           ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@map("sales_order_item_modifiers")
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_WALLET
  TRANSFER
}

enum PaymentRecordStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Payment {
  id             String              @id @default(uuid())
  orderId        String
  idempotencyKey String              @unique
  method         PaymentMethod
  provider       String?             // "YAPE", "PLIN", "VISA", "MASTERCARD"
  reference      String?             // Nro de operación / voucher
  status         PaymentRecordStatus @default(COMPLETED)
  amount         Decimal             @db.Decimal(12, 2)
  tipAmount      Decimal             @default(0.00) @db.Decimal(12, 2)
  cashTendered   Decimal?            @db.Decimal(12, 2)
  changeDue      Decimal?            @db.Decimal(12, 2)
  paidAt         DateTime            @default(now())

  order          Order               @relation(fields: [orderId], references: [id])
  refunds        Refund[]

  @@map("sales_payments")
}

model Refund {
  id               String   @id @default(uuid())
  orderId          String
  paymentId        String
  amount           Decimal  @db.Decimal(12, 2)
  reason           String
  approvedByUserId String
  createdAt        DateTime @default(now())

  order            Order    @relation(fields: [orderId], references: [id])
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@map("sales_refunds")
}

// ==========================================
// CONTROL DE CAJA Y TURNOS
// ==========================================

enum ShiftStatus {
  OPEN
  CLOSED
}

model RegisterShift {
  id                   String      @id @default(uuid())
  storeId              String
  registerId           String
  userId               String
  closedByUserId       String?
  openedAt             DateTime    @default(now())
  closedAt             DateTime?
  initialCash          Decimal     @db.Decimal(12, 2) // Fondo inicial de sencillo
  declaredCash         Decimal?    @db.Decimal(12, 2) // Arqueo ciego
  expectedCashSnapshot Decimal?    @db.Decimal(12, 2) // Snapshot calculado al cierre
  difference           Decimal?    @db.Decimal(12, 2) // Diferencia (descuadre si existe)
  approvedByUserId     String?
  status               ShiftStatus @default(OPEN)

  store                Store       @relation(fields: [storeId], references: [id])
  register             Register    @relation(fields: [registerId], references: [id])
  user                 User        @relation("ShiftOpenedBy", fields: [userId], references: [id])
  closedByUser         User?       @relation("ShiftClosedBy", fields: [closedByUserId], references: [id])
  orders               Order[]
  transactions         CashTransaction[]

  @@map("cash_shifts")
}

enum CashTransactionType {
  EXPENSE    // Salida menor (ej. compra urgente de hielo)
  CASH_DROP  // Retiro parcial de seguridad
  FLOAT_IN   // Ingreso adicional de cambio
}

model CashTransaction {
  id               String              @id @default(uuid())
  shiftId          String
  type             CashTransactionType
  amount           Decimal             @db.Decimal(12, 2)
  reason           String
  approvedByUserId String
  createdAt        DateTime            @default(now())

  shift            RegisterShift       @relation(fields: [shiftId], references: [id])

  @@map("cash_transactions")
}
